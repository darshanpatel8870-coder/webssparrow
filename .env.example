# Next.js Environment Variables Template

# Base URL (used for SEO schema URLs)
NEXT_PUBLIC_BASE_URL=https://webssparrow.com

# Google Sheets Spreadsheet Webhook (Paste your Google Apps Script Web App URL here)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_GOOGLE_APPS_SCRIPT_ID/exec

# Form submission email notifications setup
# SMTP_HOST=smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# NOTIFICATION_EMAIL=darshan@webssparrow.com
